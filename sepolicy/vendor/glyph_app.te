type vendor_sysfs_glyph, sysfs_type, fs_type;

allow glyph_app sysfs_leds:dir search;
allow glyph_app sysfs_powershare:file rw_file_perms;

allow glyph_app vendor_sysfs_battery_supply:dir search;
allow glyph_app vendor_sysfs_battery_supply:file { read open getattr };

allow glyph_app vendor_sysfs_glyph:file { read open getattr };
allow glyph_app vendor_sysfs_glyph:dir search;

rw_dir_file(glyph_app, vendor_sysfs_glyph)
