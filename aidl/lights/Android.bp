rust_binary {
    name: "android.hardware.light-service.nothing",
    relative_install_path: "hw",
    init_rc: ["android.hardware.light-service.nothing.rc"],
    vintf_fragments: ["android.hardware.light-service.nothing.xml"],
    vendor: true,
    rustlibs: [
        "liblogger",
        "liblog_rust",
        "libbinder_rs",
        "liblibc",
        "android.hardware.light-V3-rust",
    ],
    srcs: ["main.rs"],
}
